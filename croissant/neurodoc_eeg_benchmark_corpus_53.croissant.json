  "@type": "sc:Dataset",
  "name": "NeuroDoc EEG Benchmark Corpus (NeurIPS 2026 Camera-Ready Snapshot)",
  "description": "A human-reviewed EEG benchmark corpus for dataset-to-task mapping. Each released entry pairs a structured task document with a dataset-specific normalization kernel. This versioned camera-ready snapshot contains the 53 completed benchmark entries and 245 task definitions evaluated in the NeurIPS 2026 submission.",
  "url": "https://github.com/Baizhige/neurodoc/",
  "license": "https://creativecommons.org/licenses/by-nc/4.0/",
  "version": "neurips-2026-camera-ready-53-entries",
  "datePublished": "2026-10-21",
  "citation": "Qin, Chengxuan, et al. EEG Benchmarking Needs a Task Specification Layer: NeuroDoc for Rulebook-Guided, Executable Benchmark Construction. NeurIPS 2026 Evaluations and Datasets Track.",
