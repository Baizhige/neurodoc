  "@type": "sc:Dataset",
  "name": "NeuroDoc EEG Benchmark Corpus (Review Release: 53 Completed Entries)",
  "description": "A community-reviewed EEG benchmark corpus for dataset-to-task mapping. Each released entry pairs a human-readable task document with a dataset-specific task kernel, turning heterogeneous public EEG datasets into executable benchmark interfaces. This review release summarizes 53 completed benchmark entries and 245 task definitions used in the NeurIPS 2026 submission.",
  "url": "https://anonymous.4open.science/r/anonymous_reviewe_neurodoc",
  "license": "https://creativecommons.org/licenses/by-nc/4.0/",
  "version": "review-release-53-completed-entries",
  "keywords": [
    "EEG",
    "benchmark",
    "dataset-to-task mapping",
    "foundation models",
    "community review",
    "executable benchmark"
  ],
  "dct:conformsTo": [
    "http://mlcommons.org/croissant/1.1",
    "http://mlcommons.org/croissant/RAI/1.0"
  ],
