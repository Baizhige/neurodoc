# Project-specific exclusions
/Script/
/.pdf_archive/
/_archive/
# app_kernel — per-machine data (locator caches and machine configs are local only)
/app_kernel/locator_cache/**
!/app_kernel/locator_cache/.gitkeep
/app_kernel/machine_config/**
!/app_kernel/machine_config/.gitkeep
**/references/
**/references/**

# Editor and workspace files
.vscode/
.idea/
.claude/
.codex

# OS-generated hidden files
.DS_Store
Thumbs.db
Desktop.ini

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# LaTeX / document build artifacts
*.aux
*.log
*.nav
*.out
*.snm
*.toc
*.synctex.gz

# Temporary files
*.tmp
*.temp
*~
