# Project-specific exclusions
/Script/
/.pdf_archive/
/_archive/
# Script/ stores per-machine runtime data and archives that should not sync via Git.
/app/config.json
/neuroaudit/config.json
# neuroaudit/config.json stores local endpoint, model, key, and proxy settings.
**/machine_config/*.json
**/locator_cache/
**/references/
**/references/**

# Secrets and local environment files
.env
.env.*
!.env.example
*.pem
*.key

# Editor and workspace files
.vscode/
.idea/
.claude/
.pytest_cache/
.codex

# OS-generated hidden files
.DS_Store
Thumbs.db
Desktop.ini

# Python cache
__pycache__/
.venv/
*.pyc
*.pyo
*.pyd

# LaTeX / document build artifacts
*.aux
*.log
*.nav
*.out
*.snm
*.toc
*.synctex.gz

# Temporary files
*.tmp
*.temp
*~
venv/
