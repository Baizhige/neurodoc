# Project-specific exclusions
/Script/
/.pdf_archive/
/_archive/
# Script/ stores per-machine runtime data and archives that should not sync via Git.
**/references/
**/references/**

# Editor and workspace files
.vscode/
.idea/
.claude/
.codex

# OS-generated hidden files
.DS_Store
Thumbs.db
Desktop.ini

# Python cache
__pycache__/
.venv/
*.pyc
*.pyo
*.pyd

# LaTeX / document build artifacts
*.aux
*.log
*.nav
*.out
*.snm
*.toc
*.synctex.gz

# Temporary files
*.tmp
*.temp
*~
